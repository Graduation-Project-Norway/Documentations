      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Medical Representative - AI Visit Planning &amp; Pre-Call Advisory\n\nleft to right direction\n\nskinparam backgroundColor #F8FAFC\nskinparam shadowing false\nskinparam actorStyle awesome\nskinparam roundcorner 18\nskinparam packageStyle rectangle\nskinparam packageBackgroundColor #EAF2F8\nskinparam packageBorderColor #4F6D8A\nskinparam packagePadding 25\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\nskinparam usecase {\n    BackgroundColor #FFFFFF\n    BorderColor #4F6D8A\n    ArrowColor #4F6D8A\n    FontColor #263746\n}\n\nskinparam note {\n    BackgroundColor #FFFDF2\n    BorderColor #C9B77D\n    FontColor #454545\n}\n\nactor \&quot;Medical Representative\&quot; as MedRep\n\nrectangle \&quot;AI Visit Planning &amp; Pre-Call Advisory\&quot; {\n\n    package \&quot;01 - AI Visit Planning\&quot; {\n\n        usecase \&quot;Generate Monthly\\nVisit Plan\&quot; as UC08\n        usecase \&quot;Review Monthly\\nVisit Plan\&quot; as UC09\n        usecase \&quot;Modify Visit Plan\&quot; as UC10\n\n        UC10 ..&gt; UC09 : &lt;&lt;extend&gt;&gt;\n    }\n\n    package \&quot;02 - AI Pre-Call Advisory\&quot; {\n\n        usecase \&quot;Generate AI Pre-Call\\nRecommendations\&quot; as UC12\n        usecase \&quot;Review AI Pre-Call\\nRecommendations\&quot; as UC13\n    }\n}\n\nactor \&quot;AI Service\&quot; as AI\n\n&#39; Medical Representative\nMedRep -left-&gt; UC09\nMedRep -left-&gt; UC13\n\n&#39; AI Service\nAI -right-&gt; UC08\nAI -right-&gt; UC12\n\n&#39; &#39; Notes\n&#39; note right of UC08\n&#39;   **Monthly Planning**\n&#39;   The plan is divided into three cycles.\n\n&#39;   The AI considers:\n&#39;   - Doctor classification (A/B/C)\n&#39;   - Required visit frequency\n&#39;   - Fixed visit days\n&#39;   - Geographic locations\n\n&#39;   Every assigned doctor must be\n&#39;   included in each cycle, with\n&#39;   repeated visits when required.\n\n&#39;   Unclassified doctors receive\n&#39;   suggested visit dates based on\n&#39;   available fixed days and location.\n&#39; end note\n\n&#39; note right of UC12\n&#39;   **Recommendation Inputs**\n&#39;   - Doctor profile and specialty\n&#39;   - Doctor classification\n&#39;   - Previous visit history\n&#39;   - Previous feedback and objections\n&#39;   - Registered company product database\n&#39;   - MedRep&#39;s available promotional custody\n\n&#39;   **For Unclassified Doctors**\n&#39;   - Specialty discovery questions\n&#39;   - Introductory gift suggestions\n\n&#39;   **For Classified Doctors**\n&#39;   - Personalized talking points\n&#39;   - Feedback and objection analysis\n&#39;   - Product recommendations\n&#39;   - Product features to highlight\n&#39;   - Promotional item recommendations\n&#39; end note\n\n&#39; note bottom of UC10\n&#39;   The MedRep can manually modify\n&#39;   the generated monthly visit plan.\n&#39; end note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="SGYwsJkY14Erd2L5TeL--1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
