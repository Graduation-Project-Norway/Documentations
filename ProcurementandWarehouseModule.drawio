        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Procurement and Warehouse Management\n\nleft to right direction\n\nskinparam backgroundColor #F8FAFC\nskinparam shadowing false\nskinparam actorStyle awesome\nskinparam roundcorner 18\nskinparam packageStyle rectangle\nskinparam packageBackgroundColor #EAF2F8\nskinparam packageBorderColor #4F6D8A\nskinparam packagePadding 25\nskinparam defaultFontName Arial\nskinparam linetype ortho\nskinparam nodesep 75\nskinparam ranksep 85\n\nskinparam usecase {\n    BackgroundColor #FFFFFF\n    BorderColor #4F6D8A\n    ArrowColor #4F6D8A\n    FontColor #263746\n}\n\nskinparam note {\n    BackgroundColor #FFFDF2\n    BorderColor #C9B77D\n    FontColor #454545\n}\n\nactor \&quot;Procurement Staff\&quot; as Procurement\nactor \&quot;Warehouse Staff\&quot; as Warehouse\n\nactor \&quot;Sales Manager\&quot; as SalesManager\nactor \&quot;QC User\&quot; as QC\n\nrectangle \&quot;Procurement and Warehouse Module\&quot; {\n\n    package \&quot;01 - Supplier &amp; Quotation Management\&quot; {\n        usecase \&quot;Manage Supplier Records\&quot; as UC1\n        usecase \&quot;Validate Supplier Information\&quot; as UC20\n        usecase \&quot;Check Duplicate Supplier Records\&quot; as UC30\n\n        usecase \&quot;Record Supplier Quotation\&quot; as UC2\n        usecase \&quot;Verify Supplier Exists\&quot; as UC50\n\n        usecase \&quot;Compare Supplier Quotations\&quot; as UC3\n\n        UC1 ..&gt; UC20 : &lt;&lt;include&gt;&gt;\n        UC1 ..&gt; UC30 : &lt;&lt;include&gt;&gt;\n        UC2 ..&gt; UC50 : &lt;&lt;include&gt;&gt;\n    }\n\n    package \&quot;02 - Warehouse Replenishment Requests\&quot; {\n        usecase \&quot;Submit Warehouse\\nReplenishment Request\&quot; as UC4\n        usecase \&quot;Specify Requested Item\\nand Quantity\&quot; as UC5\n        usecase \&quot;Review Replenishment\\nRequest\&quot; as UC6\n        usecase \&quot;Approve Replenishment\\nRequest\&quot; as UC7\n        usecase \&quot;Reject Replenishment\\nRequest\&quot; as UC8\n\n        UC4 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\n        UC7 ..&gt; UC6 : &lt;&lt;extend&gt;&gt;\n        UC8 ..&gt; UC6 : &lt;&lt;extend&gt;&gt;\n    }\n\n    package \&quot;03 - Supplier Purchase Processing\&quot; {\n        usecase \&quot;Process Approved\\nSupplier Purchase\&quot; as UC9\n        usecase \&quot;Select Supplier\\nBased on Quotations\&quot; as UC10\n        usecase \&quot;Record Supplier\\nPurchase Order\&quot; as UC11\n        usecase \&quot;Specify Ordered Items,\\nQuantities and Prices\&quot; as UC12\n        usecase \&quot;Record Expected\\nDelivery Date\&quot; as UC13\n\n        UC9 ..&gt; UC10 : &lt;&lt;include&gt;&gt;\n        UC9 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\n        UC11 ..&gt; UC12 : &lt;&lt;include&gt;&gt;\n        UC11 ..&gt; UC13 : &lt;&lt;include&gt;&gt;\n    }\n\n    package \&quot;04 - Inter-Warehouse Transfers\&quot; {\n        usecase \&quot;Request Stock Transfer\&quot; as UC14\n        usecase \&quot;Review / Approve\\nStock Transfer\&quot; as UC15\n        usecase \&quot;Reject Stock Transfer\&quot; as UC51\n        usecase \&quot;Record Stock Transfer\&quot; as UC16\n        usecase \&quot;Deduct Stock from\\nSource Warehouse\&quot; as UC17\n        usecase \&quot;Add Stock to\\nDestination Warehouse\&quot; as UC18\n\n        UC16 ..&gt; UC17 : &lt;&lt;include&gt;&gt;\n        UC16 ..&gt; UC18 : &lt;&lt;include&gt;&gt;\n        UC15 ..&gt; UC14 : &lt;&lt;extend&gt;&gt;\n        UC51 ..&gt; UC14 : &lt;&lt;extend&gt;&gt;\n        UC15 ..&gt; UC16 : &lt;&lt;include&gt;&gt;\n    }\n\n    package \&quot;05 - Warehouse Receiving &amp; Inventory\&quot; {\n        usecase \&quot;Record Goods Receipt\&quot; as UC19\n        usecase \&quot;Inspect Received Quantity\&quot; as UC21\n        usecase \&quot;Update Warehouse Inventory\&quot; as UC22\n        usecase \&quot;Manage Warehouses\&quot; as UC23\n        usecase \&quot;View Inventory\&quot; as UC24\n        usecase \&quot;View Procurement Reports\&quot; as UC25\n\n        UC19 ..&gt; UC21 : &lt;&lt;include&gt;&gt;\n        UC19 ..&gt; UC22 : &lt;&lt;include&gt;&gt;\n    }\n}\n\n&#39; Procurement Staff\nProcurement -left-&gt; UC1\nProcurement -left-&gt; UC2\nProcurement -left-&gt; UC3\nProcurement -left-&gt; UC9\nProcurement -left-&gt; UC10\nProcurement -left-&gt; UC11\nProcurement -left-&gt; UC25\n\n&#39; Supplier\n\n\n&#39; Warehouse Staff\nWarehouse -right-&gt; UC4\nWarehouse -right-&gt; UC14\nWarehouse -right-&gt; UC19\nWarehouse -right-&gt; UC23\nWarehouse -right-&gt; UC24\n\n&#39; Sales Manager\nSalesManager -right-&gt; UC6\nSalesManager -right-&gt; UC7\nSalesManager -right-&gt; UC8\nSalesManager -right-&gt; UC15\nSalesManager -right-&gt; UC51\n\n&#39; QC User\nQC -right-&gt; UC21\n\n&#39; Actor layout hints\n\nWarehouse -[hidden]down- SalesManager\nSalesManager -[hidden]down- QC\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Tl0VjXd_3L5LkVvnG1Dn-1">
