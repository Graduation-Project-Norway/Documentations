        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Medical Representative - Promotional Inventory &amp; Gift Management\n\nleft to right direction\n\nskinparam backgroundColor #F8FAFC\nskinparam shadowing false\nskinparam actorStyle awesome\nskinparam roundcorner 15\nskinparam packageStyle rectangle\nskinparam packageBackgroundColor #EAF2F8\nskinparam packageBorderColor #4F6D8A\nskinparam usecase {\n    BackgroundColor #F8FAFC\n    BorderColor #4F6D8A\n    ArrowColor #4F6D8A\n}\nskinparam defaultFontName Arial\nskinparam packagePadding 20\n\nactor \&quot;Medical Representative\&quot; as MedRep\nactor \&quot;Warehouse Staff\&quot; as Warehouse\nactor \&quot;Sales Manager\&quot; as SalesManager\n\nrectangle \&quot;Promotional Inventory &amp; Gift Management\&quot; {\n\n    usecase \&quot;Submit Promotional\\nCustody Request\&quot; as UC13\n    usecase \&quot;Record Promotional\\nItem Delivery\&quot; as UC14\n    usecase \&quot;Update MedRep\\nPromotional Custody\&quot; as UC15\n\n    usecase \&quot;Submit Special &amp;\\nExperiential Gift Request\&quot; as UC16\n    usecase \&quot;Review Special\\nGift Requests\&quot; as UC17\n    usecase \&quot;Approve Special\\nGift Request\&quot; as UC18\n    usecase \&quot;Reject Special\\nGift Request\&quot; as UC19\n\n    UC14 ..&gt; UC15 : &lt;&lt;include&gt;&gt;\n    UC18 ..&gt; UC17 : &lt;&lt;extend&gt;&gt;\n    UC19 ..&gt; UC17 : &lt;&lt;extend&gt;&gt;\n}\n\nMedRep --&gt; UC13\nMedRep --&gt; UC16\n\nWarehouse --&gt; UC14\n\nSalesManager --&gt; UC17\nSalesManager --&gt; UC18\nSalesManager --&gt; UC19\n\nnote right of UC15\n  MedRep custody is updated\n  after request approval and\n  promotional item delivery.\n\n  Custody deductions are recorded\n  after verified GPS clinic visits.\nend note\n\nnote right of UC17\n  Special and experiential gifts\n  include customized physical items\n  and non-material gifts such as trips.\n\n  These requests are tracked\n  administratively only.\n\n  They do not affect warehouse\n  stock or MedRep custody.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8Xc3hnH6fMIMHupg4c5Y-1">
