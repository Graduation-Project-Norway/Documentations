          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Medical Representative Manager - Doctor List Management\n\nleft to right direction\n\nskinparam backgroundColor #F8FAFC\nskinparam shadowing false\nskinparam actorStyle awesome\nskinparam roundcorner 18\nskinparam packageStyle rectangle\nskinparam packageBackgroundColor #EAF2F8\nskinparam packageBorderColor #4F6D8A\nskinparam packagePadding 25\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\nskinparam usecase {\n    BackgroundColor #FFFFFF\n    BorderColor #4F6D8A\n    ArrowColor #4F6D8A\n    FontColor #263746\n}\n\nactor \&quot;Medical Representative\\nManager\&quot; as Manager\n\nrectangle \&quot;Doctor List Management\&quot; {\n\n    package \&quot;Doctor List Operations\&quot; {\n\n        usecase \&quot;View Medical Representatives&#39;\\nDoctor Lists\&quot; as UC01\n        usecase \&quot;View Doctor List\&quot; as UC02\n        usecase \&quot;Add Doctor to\\nDoctor List\&quot; as UC03\n        usecase \&quot;View Doctor Profile\&quot; as UC04\n        usecase \&quot;Update Doctor Information\&quot; as UC05\n        usecase \&quot;Remove Doctor from\\nDoctor List\&quot; as UC06\n    }\n\n    package \&quot;Access &amp; Data Validations\&quot; {\n\n        usecase \&quot;Validate Manager&#39;s\\nTeam Access\&quot; as V01\n        usecase \&quot;Validate Doctor\\nInformation\&quot; as V02\n        usecase \&quot;Check for Duplicate\\nDoctor Entry\&quot; as V03\n        usecase \&quot;Validate Doctor List\\nOwnership\&quot; as V04\n        usecase \&quot;Validate Updated\\nDoctor Information\&quot; as V05\n        usecase \&quot;Confirm Doctor\\nRemoval\&quot; as V06\n    }\n\n    &#39; Mandatory Validations\n    UC01 ..&gt; V01 : &lt;&lt;include&gt;&gt;\n    UC02 ..&gt; V01 : &lt;&lt;include&gt;&gt;\n    UC03 ..&gt; V01 : &lt;&lt;include&gt;&gt;\n    UC03 ..&gt; V02 : &lt;&lt;include&gt;&gt;\n    UC03 ..&gt; V03 : &lt;&lt;include&gt;&gt;\n    UC04 ..&gt; V04 : &lt;&lt;include&gt;&gt;\n    UC05 ..&gt; V04 : &lt;&lt;include&gt;&gt;\n    UC05 ..&gt; V05 : &lt;&lt;include&gt;&gt;\n    UC06 ..&gt; V04 : &lt;&lt;include&gt;&gt;\n    UC06 ..&gt; V06 : &lt;&lt;include&gt;&gt;\n}\n\n&#39; Manager Associations\nManager -left-&gt; UC01\nManager -left-&gt; UC02\nManager -left-&gt; UC03\nManager -left-&gt; UC04\nManager -left-&gt; UC05\nManager -left-&gt; UC06\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4wsWQGd7lSl79x3RH9Tt-54">
