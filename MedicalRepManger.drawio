  <diagram name="Page-1" id="4uU09y8fyz5pkj35gI_2">
    <mxGraphModel dx="2644" dy="-40" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Medical Representative Manager - Doctor List Management\n\nleft to right direction\n\nskinparam backgroundColor #F8FAFC\nskinparam shadowing false\nskinparam actorStyle awesome\nskinparam roundcorner 18\nskinparam packageStyle rectangle\nskinparam packageBackgroundColor #EAF2F8\nskinparam packageBorderColor #4F6D8A\nskinparam packagePadding 25\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\nskinparam usecase {\n    BackgroundColor #FFFFFF\n    BorderColor #4F6D8A\n    ArrowColor #4F6D8A\n    FontColor #263746\n}\n\nskinparam note {\n    BackgroundColor #FFFDF2\n    BorderColor #C9B77D\n    FontColor #454545\n}\n\nactor \&quot;Medical Representative\\nManager\&quot; as Manager\n\nrectangle \&quot;Doctor List Management\&quot; {\n\n    package \&quot;Managed Medical Representatives&#39; Doctor Lists\&quot; {\n\n        usecase \&quot;View Medical Representatives&#39;\\nDoctor Lists\&quot; as UC01\n        usecase \&quot;View Doctor List\&quot; as UC02\n        usecase \&quot;Add Doctor to\\nDoctor List\&quot; as UC03\n        usecase \&quot;View Doctor Profile\&quot; as UC04\n        usecase \&quot;Update Doctor Information\&quot; as UC05\n        usecase \&quot;Remove Doctor from\\nDoctor List\&quot; as UC06\n    }\n}\n\n&#39; Manager Permissions\nManager -left-&gt; UC01\nManager -left-&gt; UC02\nManager -left-&gt; UC03\nManager -left-&gt; UC04\nManager -left-&gt; UC05\nManager -left-&gt; UC06\n\n&#39; Manager Access Validation\nnote right of UC01\n  **Access Validation**\n  - The Manager can only access\n    lists belonging to Medical\n    Representatives under their management.\n  - Access to other Managers&#39; lists\n    is not permitted.\nend note\n\n&#39; Add Doctor Validation\nnote right of UC03\n  **Add Doctor Validation**\n  - The selected Medical Representative\n    must belong to the Manager&#39;s team.\n  - Required doctor information must\n    be provided.\n  - Input data must follow the\n    accepted field formats.\n  - Prevent duplicate doctor entries\n    in the same list.\nend note\n\n&#39; View Doctor Validation\nnote bottom of UC04\n  **Profile Access Validation**\n  - The doctor must belong to a list\n    accessible by the Manager.\n  - The Manager can only view profiles\n    within their management scope.\nend note\n\n&#39; Update Doctor Validation\nnote bottom of UC05\n  **Update Validation**\n  - The doctor must belong to a\n    managed Medical Representative&#39;s list.\n  - Updated required fields must not\n    be empty.\n  - Updated values must follow\n    the accepted field formats.\nend note\n\n&#39; Remove Doctor Validation\nnote bottom of UC06\n  **Removal Validation**\n  - The doctor must belong to a\n    managed Medical Representative&#39;s list.\n  - The system asks for confirmation\n    before removal.\n  - Removal affects the selected\n    doctor list only.\nend note\n\n&#39; General List Validation\nnote bottom of UC02\n  **List Access Validation**\n  - Only lists of assigned Medical\n    Representatives can be displayed.\n  - The Manager cannot access\n    unauthorized lists.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4wsWQGd7lSl79x3RH9Tt-24">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Access Validation&lt;/b&gt;&lt;br&gt;- The Manager can only access&lt;br&gt;lists belonging to Medical&lt;br&gt;Representatives under their management.&lt;br&gt;- Access to other Managers&#39; lists&lt;br&gt;is not permitted." plantUmlId="note_16" plantUmlBaseStyle="shape=note;size=10;fillColor=#FFFDF2;strokeColor=#C9B77D;fontSize=13;whiteSpace=wrap;align=left;spacingLeft=4;rounded=1;arcSize=18;absoluteArcSize=1;shadow=0;fontColor=#454545;fontFamily=Arial;html=1;" plantUmlBaseValue="&lt;b&gt;Access Validation&lt;/b&gt;&lt;br&gt;- The Manager can only access&lt;br&gt;lists belonging to Medical&lt;br&gt;Representatives under their management.&lt;br&gt;- Access to other Managers&#39; lists&lt;br&gt;is not permitted." id="4wsWQGd7lSl79x3RH9Tt-41">
          <mxCell parent="4wsWQGd7lSl79x3RH9Tt-24" style="shape=note;size=10;fillColor=#FFFDF2;strokeColor=#C9B77D;fontSize=13;whiteSpace=wrap;align=left;spacingLeft=4;rounded=1;arcSize=18;absoluteArcSize=1;shadow=0;fontColor=#454545;fontFamily=Arial;html=1;" vertex="1">
